{
  "agents": [
    {
      "target": "claude",
      "image_name": "claude",
      "docker_context": "docker/claude",
      "dockerfile": "docker/claude/Dockerfile",
      "version_command": "claude --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "build_args": { "CLAUDE_CODE_CHANNEL": "latest" },
      "automation": {
        "enabled": true,
        "source": { "type": "github_release", "repo": "anthropics/claude-code" }
      }
    },
    {
      "target": "gemini",
      "image_name": "gemini",
      "docker_context": "docker/gemini",
      "dockerfile": "docker/gemini/Dockerfile",
      "version_command": "export HOME=/tmp/gemini-home; mkdir -p \"$HOME/.gemini\"; NODE_NO_WARNINGS=1 node /usr/local/bin/gemini --version",
      "platforms": ["linux/amd64"],
      "automation": {
        "enabled": true,
        "source": { "type": "npm", "package": "@google/gemini-cli" }
      }
    },
    {
      "target": "opencode",
      "image_name": "opencode",
      "docker_context": "docker/opencode",
      "dockerfile": "docker/opencode/Dockerfile",
      "version_command": "opencode --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "automation": {
        "enabled": true,
        "source": { "type": "npm", "package": "opencode-ai" }
      }
    },
    {
      "target": "devstral",
      "image_name": "devstral",
      "docker_context": "docker/devstral",
      "dockerfile": "docker/devstral/Dockerfile",
      "version_command": "vibe --version",
      "platforms": ["linux/amd64"],
      "automation": {
        "enabled": true,
        "source": { "type": "github_release", "repo": "mistralai/mistral-vibe" }
      }
    },
    {
      "target": "auggie",
      "image_name": "auggie",
      "docker_context": "docker/auggie",
      "dockerfile": "docker/auggie/Dockerfile",
      "version_command": "auggie --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "automation": {
        "enabled": true,
        "source": { "type": "npm", "package": "@augmentcode/auggie" }
      }
    },
    {
      "target": "copilot",
      "image_name": "copilot",
      "docker_context": "docker/copilot",
      "dockerfile": "docker/copilot/Dockerfile",
      "version_command": "copilot --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "automation": {
        "enabled": true,
        "source": { "type": "npm", "package": "@github/copilot" }
      }
    },
    {
      "target": "codex",
      "image_name": "codex",
      "docker_context": "docker/codex",
      "dockerfile": "docker/codex/Dockerfile",
      "version_command": "codex --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "automation": {
        "enabled": true,
        "source": { "type": "npm", "package": "@openai/codex" }
      }
    },
    {
      "target": "pi",
      "image_name": "pi",
      "docker_context": "docker/pi",
      "dockerfile": "docker/pi/Dockerfile",
      "version_command": "pi --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "automation": {
        "enabled": true,
        "source": {
          "type": "npm",
          "package": "@earendil-works/pi-coding-agent"
        }
      }
    },
    {
      "target": "agy",
      "image_name": "agy",
      "docker_context": "docker/agy",
      "dockerfile": "docker/agy/Dockerfile",
      "version_command": "agy --version",
      "platforms": ["linux/amd64"],
      "automation": {
        "enabled": true,
        "source": {
          "type": "github_release",
          "repo": "google-antigravity/antigravity-cli"
        }
      }
    },
    {
      "target": "tau",
      "image_name": "tau",
      "docker_context": "docker/tau",
      "dockerfile": "docker/tau/Dockerfile",
      "version_command": "tau --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "version_build_arg": "TAU_VERSION",
      "automation": {
        "enabled": true,
        "source": { "type": "pypi", "package": "tau-ai" }
      }
    },
    {
      "target": "jcode",
      "image_name": "jcode",
      "docker_context": "docker/jcode",
      "dockerfile": "docker/jcode/Dockerfile",
      "version_command": "jcode --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "version_build_arg": "JCODE_VERSION",
      "automation": {
        "enabled": true,
        "source": { "type": "github_release", "repo": "1jehuang/jcode" }
      }
    },
    {
      "target": "qwen",
      "image_name": "qwen",
      "docker_context": "docker/qwen",
      "dockerfile": "docker/qwen/Dockerfile",
      "version_command": "qwen --version",
      "platforms": ["linux/amd64", "linux/arm64"],
      "version_build_arg": "QWEN_VERSION",
      "automation": {
        "enabled": true,
        "source": { "type": "npm", "package": "@qwen-code/qwen-code" }
      }
    }
  ]
}
